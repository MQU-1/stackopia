{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Stackopia design tokens — DTCG format. Dark-first financial app with lime-green (#C8F135) primary, Syne display type, DM Sans body. Edit only this file; build-tokens.mjs generates src/index.css and src/generated/tokens.tsx.",
  "color": {
    "$type": "color",
    "light": {
      "background":          { "$value": "#FAFAF5", "$description": "Warm off-white page background." },
      "foreground":          { "$value": "#0D0D0D" },
      "border":              { "$value": "#E0E0DB" },
      "card":                { "$value": "#FFFFFF" },
      "cardForeground":      { "$value": "#0D0D0D" },
      "popover":             { "$value": "#FFFFFF" },
      "popoverForeground":   { "$value": "#0D0D0D" },
      "primary":             { "$value": "#5D8C0A", "$description": "Lime-derived primary for light mode — AAA contrast on white." },
      "primaryForeground":   { "$value": "#FFFFFF" },
      "secondary":           { "$value": "#F2F2ED" },
      "secondaryForeground": { "$value": "#0D0D0D" },
      "muted":               { "$value": "#F2F2ED" },
      "mutedForeground":     { "$value": "#707070" },
      "accent":              { "$value": "#2E8B57", "$description": "Darker emerald green for light backgrounds." },
      "accentForeground":    { "$value": "#FFFFFF" },
      "destructive":         { "$value": "#E53939" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input":               { "$value": "#E0E0DB" },
      "ring":                { "$value": "#5D8C0A" },
      "chart1":              { "$value": "#5D8C0A" },
      "chart2":              { "$value": "#2E8B57" },
      "chart3":              { "$value": "#C4900C" },
      "chart4":              { "$value": "#E53939" },
      "chart5":              { "$value": "#2B92C5" },
      "sidebar":             { "$value": "#F2F2ED" },
      "sidebarForeground":   { "$value": "#0D0D0D" },
      "sidebarBorder":       { "$value": "#E0E0DB" },
      "sidebarPrimary":      { "$value": "#5D8C0A" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent":       { "$value": "#E6E6E1" },
      "sidebarAccentForeground": { "$value": "#0D0D0D" },
      "sidebarRing":         { "$value": "#5D8C0A" }
    },
    "dark": {
      "background":          { "$value": "#080808", "$description": "Near-black canvas — Stackopia dark base." },
      "foreground":          { "$value": "#F0F0F0" },
      "border":              { "$value": "#222222" },
      "card":                { "$value": "#111111", "$description": "Elevated card surface." },
      "cardForeground":      { "$value": "#F0F0F0" },
      "popover":             { "$value": "#111111" },
      "popoverForeground":   { "$value": "#F0F0F0" },
      "primary":             { "$value": "#C8F135", "$description": "Stackopia signature lime — drives buttons, active nav, and CTAs." },
      "primaryForeground":   { "$value": "#080808" },
      "secondary":           { "$value": "#181818", "$description": "Card2 — slightly lighter inset surface." },
      "secondaryForeground": { "$value": "#F0F0F0" },
      "muted":               { "$value": "#181818" },
      "mutedForeground":     { "$value": "#666666" },
      "accent":              { "$value": "#7EE8A2", "$description": "Soft emerald for positive indicators and success states." },
      "accentForeground":    { "$value": "#080808" },
      "destructive":         { "$value": "#FF6B6B", "$description": "Coral-red for warnings and bad-spend signals." },
      "destructiveForeground": { "$value": "#080808" },
      "input":               { "$value": "#222222" },
      "ring":                { "$value": "#C8F135" },
      "chart1":              { "$value": "#C8F135" },
      "chart2":              { "$value": "#7EE8A2" },
      "chart3":              { "$value": "#FFD166" },
      "chart4":              { "$value": "#FF6B6B" },
      "chart5":              { "$value": "#5BC4F5" },
      "sidebar":             { "$value": "#0D0D0D" },
      "sidebarForeground":   { "$value": "#F0F0F0" },
      "sidebarBorder":       { "$value": "#222222" },
      "sidebarPrimary":      { "$value": "#C8F135" },
      "sidebarPrimaryForeground": { "$value": "#080808" },
      "sidebarAccent":       { "$value": "#1A1A1A" },
      "sidebarAccentForeground": { "$value": "#F0F0F0" },
      "sidebarRing":         { "$value": "#C8F135" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["DM Sans", "sans-serif"],  "$description": "Body and UI text. 300–600 weight range." },
      "serif": { "$value": ["Syne", "sans-serif"],     "$description": "Display and brand headings. 700–800 weight. Used as --font-serif for hero/section titles." },
      "mono":  { "$value": ["JetBrains Mono", "monospace"], "$description": "Code and numeric data." }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "1rem", "$description": "16px base radius — matches Stackopia card corners." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Base spacing step." }
  }
}
