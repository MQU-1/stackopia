{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Stackopia design tokens — DTCG format. Dark-first financial app with ink/gold/jade palette: Fraunces display type, IBM Plex Sans body (with Arabic variant for RTL). Edit only this file; build-tokens.mjs generates src/index.css and src/generated/tokens.tsx.",
  "color": {
    "$type": "color",
    "light": {
      "background":          { "$value": "#F1E9D8", "$description": "Sand page background — warm region-inspired canvas." },
      "foreground":          { "$value": "#0B2224", "$description": "Ink text on sand." },
      "border":              { "$value": "#D6CDB4", "$description": "Warm sand border." },
      "card":                { "$value": "#E8DFC9", "$description": "Softer sand card surface." },
      "cardForeground":      { "$value": "#0B2224" },
      "popover":             { "$value": "#E8DFC9" },
      "popoverForeground":   { "$value": "#0B2224" },
      "primary":             { "$value": "#A97B1B", "$description": "Darker gold for light mode — readable on sand." },
      "primaryForeground":   { "$value": "#0B2224" },
      "secondary":           { "$value": "#E8DFC9" },
      "secondaryForeground": { "$value": "#0B2224" },
      "muted":               { "$value": "#DED2B4" },
      "mutedForeground":     { "$value": "#4B6362" },
      "accent":              { "$value": "#2F7A68", "$description": "Darker jade for light backgrounds." },
      "accentForeground":    { "$value": "#F1E9D8" },
      "destructive":         { "$value": "#A6523A" },
      "destructiveForeground": { "$value": "#F1E9D8" },
      "input":               { "$value": "#D6CDB4" },
      "ring":                { "$value": "#A97B1B" },
      "chart1":              { "$value": "#A97B1B" },
      "chart2":              { "$value": "#2F7A68" },
      "chart3":              { "$value": "#8A6A18" },
      "chart4":              { "$value": "#A6523A" },
      "chart5":              { "$value": "#33695E" },
      "sidebar":             { "$value": "#E8DFC9" },
      "sidebarForeground":   { "$value": "#0B2224" },
      "sidebarBorder":       { "$value": "#D6CDB4" },
      "sidebarPrimary":      { "$value": "#A97B1B" },
      "sidebarPrimaryForeground": { "$value": "#0B2224" },
      "sidebarAccent":       { "$value": "#DED2B4" },
      "sidebarAccentForeground": { "$value": "#0B2224" },
      "sidebarRing":         { "$value": "#A97B1B" }
    },
    "dark": {
      "background":          { "$value": "#0B2224", "$description": "Ink — Stackopia dark base." },
      "foreground":          { "$value": "#F1E9D8", "$description": "Sand text on ink." },
      "border":              { "$value": "#234345", "$description": "Ink line — translucent sand at 12%." },
      "card":                { "$value": "#123336", "$description": "Ink-soft card surface." },
      "cardForeground":      { "$value": "#F1E9D8" },
      "popover":             { "$value": "#123336" },
      "popoverForeground":   { "$value": "#F1E9D8" },
      "primary":             { "$value": "#C9982E", "$description": "Stackopia signature gold — drives buttons, active nav, CTAs." },
      "primaryForeground":   { "$value": "#0B2224" },
      "secondary":           { "$value": "#123336", "$description": "Ink-soft inset surface." },
      "secondaryForeground": { "$value": "#F1E9D8" },
      "muted":               { "$value": "#1A4340", "$description": "Ink-softer inset surface." },
      "mutedForeground":     { "$value": "#C9C0AC" },
      "accent":              { "$value": "#4EA189", "$description": "Jade for positive indicators and success states." },
      "accentForeground":    { "$value": "#0B2224" },
      "destructive":         { "$value": "#C0623F", "$description": "Clay for warnings and bad-spend signals." },
      "destructiveForeground": { "$value": "#F1E9D8" },
      "input":               { "$value": "#234345" },
      "ring":                { "$value": "#E3B44E" },
      "chart1":              { "$value": "#E3B44E" },
      "chart2":              { "$value": "#6BC2A8" },
      "chart3":              { "$value": "#C9982E" },
      "chart4":              { "$value": "#4EA189" },
      "chart5":              { "$value": "#B5654A" },
      "sidebar":             { "$value": "#0F2A2C" },
      "sidebarForeground":   { "$value": "#F1E9D8" },
      "sidebarBorder":       { "$value": "#234345" },
      "sidebarPrimary":      { "$value": "#C9982E" },
      "sidebarPrimaryForeground": { "$value": "#0B2224" },
      "sidebarAccent":       { "$value": "#1A4340" },
      "sidebarAccentForeground": { "$value": "#F1E9D8" },
      "sidebarRing":         { "$value": "#E3B44E" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["IBM Plex Sans", "IBM Plex Sans Arabic", "-apple-system", "sans-serif"],  "$description": "Body and UI text. Arabic variant kicks in for RTL." },
      "serif": { "$value": ["Fraunces", "Georgia", "serif"],     "$description": "Display and brand headings. 400–700 weight." },
      "mono":  { "$value": ["IBM Plex Mono", "ui-monospace", "monospace"], "$description": "Code and numeric data." }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.75rem", "$description": "12px base radius — between shadcn default and design's 16px cards." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Base spacing step." }
  }
}
